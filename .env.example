# SoukPilot — environment variables
# Copy to .env.local for development. Never commit real values.

# --- Public (exposed to the browser; safe by design, RLS protects data) ---
# Local stack: printed by `npx supabase start` (API URL / Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or, on older projects, the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key
# Base URL of this app, used in email links (confirmation, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets ---
# Not used by Milestone 1. If a future server task needs it, read it ONLY from
# server code (import "server-only"), never with a NEXT_PUBLIC_ prefix.
# SUPABASE_SECRET_KEY=
